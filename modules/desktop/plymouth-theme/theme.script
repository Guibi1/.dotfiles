# Adapted from Apple Mac Plymouth Bar v1.1 by Navis Michael Bearly:
# https://github.com/navisjayaseelan/apple-mac-plymouth

screenWidth = Window.GetWidth();
screenHeight = Window.GetHeight();

wallpaper = Image("wallpaper.png");
if (wallpaper.GetWidth() * screenHeight > wallpaper.GetHeight() * screenWidth)
  background = wallpaper.Scale(Math.Int(wallpaper.GetWidth() * screenHeight / wallpaper.GetHeight()), screenHeight);
else
  background = wallpaper.Scale(screenWidth, Math.Int(wallpaper.GetHeight() * screenWidth / wallpaper.GetWidth()));

background_sprite = Sprite(background);
background_sprite.SetPosition(
  Window.GetX() + (screenWidth - background.GetWidth()) / 2,
  Window.GetY() + (screenHeight - background.GetHeight()) / 2,
  -100
);

#----------------------------------------- Dialogue --------------------------------

status = "normal";

fun dialog_setup()
{
  local.field_image = Image("input-field.png");
  local.field_sprite = Sprite(field_image);
  field_sprite.SetPosition(
    Window.GetX() + (screenWidth - field_image.GetWidth()) / 2,
    Window.GetY() + screenHeight - 90 - field_image.GetHeight() / 2,
    10000
  );

  local.placeholder_image = Image.Text("Mot de passe", 1, 1, 1, 1, "Cascadia Code PL 10");
  local.placeholder_sprite = Sprite(placeholder_image);
  placeholder_sprite.SetPosition(
    Window.GetX() + (screenWidth - placeholder_image.GetWidth()) / 2,
    Window.GetY() + screenHeight - 90 - placeholder_image.GetHeight() / 2,
    10001
  );

  local.bullet_image = Image.Text("●", 1, 1, 1, 1, "Cascadia Code PL 14");
  global.dialog = local;
  dialog_opacity(1);
}

fun dialog_opacity(opacity)
{
  dialog.field_sprite.SetOpacity(opacity);
  dialog.placeholder_sprite.SetOpacity(opacity * 0.7);
  for (index = 0; dialog.bullet[index]; index++)
    dialog.bullet[index].sprite.SetOpacity(opacity * 0.7);
}

fun display_normal_callback()
{
  global.status = "normal";
  if (global.dialog)
    dialog_opacity(0);
  if (Plymouth.GetMode() == "boot") {
    progress_box.sprite.SetOpacity(1);
    if (progress_bar.pixels > 0)
      progress_bar.sprite.SetOpacity(1);
  }
}

fun display_password_callback(prompt, bullets)
{
  global.status = "password";
  if (Plymouth.GetMode() == "boot") {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
  }

  if (!global.dialog)
    dialog_setup();
  else
    dialog_opacity(1);

  local.count = Math.Min(16, Math.Max(0, bullets));
  if (count == 0)
    dialog.placeholder_sprite.SetOpacity(0.7);
  else
    dialog.placeholder_sprite.SetOpacity(0);

  for (index = 0; dialog.bullet[index] || index < count; index++) {
    if (!dialog.bullet[index])
      dialog.bullet[index].sprite = Sprite(dialog.bullet_image);
    if (index < count) {
      dialog.bullet[index].sprite.SetPosition(
        Window.GetX() + screenWidth / 2 - ((count - 1) * 18 + dialog.bullet_image.GetWidth()) / 2 + index * 18,
        Window.GetY() + screenHeight - 90 - dialog.bullet_image.GetHeight() / 2,
        10002
      );
      dialog.bullet[index].sprite.SetOpacity(0.7);
    } else
      dialog.bullet[index].sprite.SetOpacity(0);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Progress Bar --------------------------------

if (Plymouth.GetMode() == "boot") {
  progress_box.image = Image("progress_box.png").Scale(320, 8);
  progress_box.sprite = Sprite(progress_box.image);
  progress_box.x = Window.GetX() + (screenWidth - progress_box.image.GetWidth()) / 2;
  progress_box.y = Window.GetY() + screenHeight - 90 - progress_box.image.GetHeight() / 2;
  progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

  progress_bar.original_image = Image("progress_bar.png").Scale(318, 8);
  progress_bar.sprite = Sprite();
  progress_bar.sprite.SetPosition(progress_box.x + 1, progress_box.y, 1);
  progress_bar.sprite.SetOpacity(0);
  progress_bar.pixels = 0;

  fun progress_callback(duration, progress)
  {
    local.pixels = Math.Int(progress_bar.original_image.GetWidth() * Math.Min(1, Math.Max(0, progress)));
    if (pixels != progress_bar.pixels) {
      global.progress_bar.pixels = pixels;
      if (pixels > 0) {
        progress_bar.image = progress_bar.original_image.Scale(pixels, progress_bar.original_image.GetHeight());
        progress_bar.sprite.SetImage(progress_bar.image);
        if (status == "normal")
          progress_bar.sprite.SetOpacity(1);
      } else
        progress_bar.sprite.SetOpacity(0);
    }
  }

  Plymouth.SetBootProgressFunction(progress_callback);
}

#----------------------------------------- Quit --------------------------------

fun quit_callback()
{
  background_sprite.SetOpacity(1);
}

Plymouth.SetQuitFunction(quit_callback);

#----------------------------------------- Message --------------------------------

message_sprites = [];
message_sprite_count = 0;

fun display_message_callback(text)
{
  local.image = Image.Text(text, 1, 1, 1, 1, "Cascadia Code PL 10");
  message_sprites[message_sprite_count] = Sprite(image);
  message_sprites[message_sprite_count].SetPosition(
    Window.GetX() + (screenWidth - image.GetWidth()) / 2,
    Window.GetY() + screenHeight - 140 - message_sprite_count * image.GetHeight(),
    10000
  );
  message_sprites[message_sprite_count].text = text;
  global.message_sprite_count++;
}

fun hide_message_callback(text)
{
  for (i = 0; i < message_sprite_count; i++) {
    if (message_sprites[i].text == text)
      message_sprites[i] = NULL;
  }
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
